{
  "name": "dsh-plugin-mark-unread",
  "version": "0.1.2",
  "description": "DSH Web GUI 的「标记为未读」：给工作区会话行补一个手动未读标记（官方 completionUnread 只读且不落盘）。为官方支持前的过渡插件，自带自动退休机制。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShiTan-677/dsh-plugins.git",
    "directory": "packages/dsh-plugin-mark-unread"
  },
  "homepage": "https://github.com/ShiTan-677/dsh-plugins/tree/main/packages/dsh-plugin-mark-unread#readme",
  "bugs": {
    "url": "https://github.com/ShiTan-677/dsh-plugins/issues"
  },
  "packageManager": "pnpm@11.7.0",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "unread",
    "session"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node scripts/build-client.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/build-client.mjs --check && node --test tests/*.test.mjs",
    "watch-official": "node scripts/watch-official.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.1.7-rc.2 <0.3.0-0"
  }
}
