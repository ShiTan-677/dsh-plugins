# Generated by install.sh from share/dsh-web.service.in — edit the template, not
# this file, then re-run `./install.sh --systemd`.
[Unit]
Description=DeepSeek Harness Web GUI (dsh web on port __PORT__)
Documentation=https://github.com/ShiTan-677/linux-dsh-web-entry
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
Environment=DSH_WEB_PORT=__PORT__
ExecStart=__LAUNCHER__ --serve
WorkingDirectory=%h
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
